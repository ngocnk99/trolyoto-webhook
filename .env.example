# ─────────────────────────────────────────────────────────────
# TROLYoto FB Webhook Server — env vars
# Copy thành `.env` cho local dev, hoặc cấu hình trong Render dashboard.
# ─────────────────────────────────────────────────────────────

# Render inject PORT tự động khi deploy; default 3000 cho local
PORT=3000

# ── Facebook Messenger ──────────────────────────────────────
# Page Access Token (Page Settings → Configuration → Messenger Platform → Generate token)
FB_PAGE_ACCESS_TOKEN=

# Token dùng để verify webhook subscription (tự đặt bất kỳ, khớp với cấu hình Page Webhook)
FB_WEBHOOK_VERIFY_TOKEN=

# App Secret từ Meta App Dashboard (Settings → Basic → App Secret) — dùng verify chữ ký request
FB_APP_SECRET=

# Optional: chỉ chấp nhận event từ Page có ID này (security guard)
FACEBOOK_PAGE_ID=

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL base cho ảnh sản phẩm; fallback https://zhxqbnaoeohcryrbemqx.supabase.co/storage/v1/object/public/images
NEXT_PUBLIC_SUPABASE_IMAGE_URL=

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Search alias mining (task search-suggest-v2 GĐ3) ────────────────────────
# Cron đêm học cách khách gõ (conversation_log + search_query_log) bằng gpt-4o-mini
# → bảng search_alias → search_dictionary_refresh() (02:30 VN) nhồi vào từ điển gợi ý.
# Cần OPENAI_API_KEY (đã có) + SUPABASE_SERVICE_ROLE_KEY. Endpoint vận hành:
#   GET  /api/search-alias/status · POST /api/search-alias/run?dryRun=1 (header x-debug-secret)
SEARCH_ALIAS_CRON_ENABLED=1
SEARCH_ALIAS_CRON_TIME=01:30
SEARCH_ALIAS_MODEL=gpt-4o-mini
SEARCH_ALIAS_SESSION_BATCH=300
SEARCH_ALIAS_PHRASES_PER_CALL=60
SEARCH_ALIAS_MAX_CALLS=40
SEARCH_ALIAS_QUERY_LOG_DAYS=30
SEARCH_ALIAS_LOOKBACK_DAYS=30
