# ─────────────────────────────────────────────────────────────
# TROLYoto FB Webhook Server — env vars
# Copy thành `.env` cho local dev, hoặc cấu hình trong Render dashboard.
# ─────────────────────────────────────────────────────────────

# Render inject PORT tự động khi deploy; default 3000 cho local
PORT=3000

# ── Facebook Messenger ──────────────────────────────────────
# Page Access Token (Page Settings → Configuration → Messenger Platform → Generate token)
FB_PAGE_ACCESS_TOKEN=

# Token dùng để verify webhook subscription (tự đặt bất kỳ, khớp với cấu hình Page Webhook)
FB_WEBHOOK_VERIFY_TOKEN=

# App Secret từ Meta App Dashboard (Settings → Basic → App Secret) — dùng verify chữ ký request
FB_APP_SECRET=

# Optional: chỉ chấp nhận event từ Page có ID này (security guard)
FACEBOOK_PAGE_ID=

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL base cho ảnh sản phẩm; fallback https://zhxqbnaoeohcryrbemqx.supabase.co/storage/v1/object/public/images
NEXT_PUBLIC_SUPABASE_IMAGE_URL=

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Search alias mining (task search-suggest-v2 GĐ3) ────────────────────────
# Cron đêm học cách khách gõ (conversation_log + search_query_log) bằng gpt-4o-mini
# → bảng search_alias → search_dictionary_refresh() (02:30 VN) nhồi vào từ điển gợi ý.
# Cần OPENAI_API_KEY (đã có) + SUPABASE_SERVICE_ROLE_KEY. Endpoint vận hành:
#   GET  /api/search-alias/status · POST /api/search-alias/run?dryRun=1 (header x-debug-secret)
SEARCH_ALIAS_CRON_ENABLED=1
SEARCH_ALIAS_CRON_TIME=01:30
SEARCH_ALIAS_MODEL=gpt-4o-mini
SEARCH_ALIAS_SESSION_BATCH=300
SEARCH_ALIAS_PHRASES_PER_CALL=60
SEARCH_ALIAS_MAX_CALLS=40
SEARCH_ALIAS_QUERY_LOG_DAYS=30
SEARCH_ALIAS_LOOKBACK_DAYS=30

# 86eyuw542 GD8 (10/09/2026): cron AI tu duyet alias pending (02:00 VN, sau mining
# 01:30 truoc refresh 02:30). Verdict approve/reject/fix duoc doi chieu tu dien
# truoc khi ghi. Tat: SEARCH_ALIAS_REVIEW_ENABLED=0.
SEARCH_ALIAS_REVIEW_ENABLED=1
SEARCH_ALIAS_REVIEW_CRON_TIME=02:00
SEARCH_ALIAS_REVIEW_MODEL=gpt-4o-mini
SEARCH_ALIAS_REVIEW_ROWS_PER_CALL=25
SEARCH_ALIAS_REVIEW_MAX_CALLS=6

# ── Meta Conversions API (đợt sửa quy nguồn 06/09/2026) ─────────────────────
# Kênh server-side gửi Purchase sang Meta, đọc từ bảng meta_capi_outbox mà buyer
# ghi lúc tạo đơn. Có nó thì pixel trình duyệt và Meta mới khử trùng lặp được
# cho nhau qua `event_id` — trước đây tag pixel không gửi eventID nên Meta đếm
# đủ 104 sự kiện purchase/30 ngày trong khi GA4 chỉ tính 80 giao dịch.
#
# Lấy token: Trình quản lý sự kiện → chọn Dataset → Cài đặt → Conversions API
# → "Tạo mã truy cập". (Hoặc System User token với quyền ads_management +
# business_management nếu muốn quản trị tập trung.)
META_PIXEL_ID=1219426789719918
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# CHỈ đặt khi đang test (lấy ở tab "Sự kiện kiểm tra"). CÒN biến này thì sự kiện
# KHÔNG vào báo cáo thật — nhớ xoá sau khi test xong.
META_CAPI_TEST_EVENT_CODE=
META_CAPI_INTERVAL_MS=60000
META_CAPI_BATCH=50
META_CAPI_MAX_ATTEMPTS=5

# Secret cho /api/meta/capi/* (header x-capi-secret). CHƯA SET = TỪ CHỐI hết.
CAPI_ADMIN_SECRET=

# Secret cho /api/debug/* và /api/search-alias/* (header x-debug-secret).
# CHƯA SET = TỪ CHỐI hết (sửa 06/09/2026; trước đó là cho qua nên các endpoint
# này đang mở ra internet trên production — set ngay trên Render).
DEBUG_SECRET=
# ── Search embedding backfill (task search-suggest-v2 GĐ4) ──────────────────
# 03:00 VN (SAU refresh 02:30) embed delta search_dictionary → cột embedding (pgvector)
# cho tầng semantic của buyer. Endpoint: GET/POST /api/search-embedding/{status,run}
SEARCH_EMBED_CRON_ENABLED=1
SEARCH_EMBED_CRON_TIME=03:00
SEARCH_EMBED_MODEL=text-embedding-3-small
SEARCH_EMBED_BATCH=200
SEARCH_EMBED_MAX_ROWS=3000
